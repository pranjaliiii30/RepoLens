# Copy to .env — never commit the real file.
GEMINI_API_KEY=             # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Where indexes, clones and feedback are stored
REPOLENS_DATA_DIR=.repolens_data
# Set to 1 ONLY on a private machine to allow indexing local folders by path
REPOLENS_ALLOW_LOCAL=0
